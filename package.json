{
  "name": "websync-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "WebSync AI — Cross-platform distributed computing platform",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:dashboard": "pnpm --filter @websync/dashboard dev",
    "dev:desktop": "pnpm --filter @websync/desktop dev",
    "build": "pnpm --filter @websync/dashboard build",
    "build:dashboard": "pnpm --filter @websync/dashboard build",
    "build:desktop": "pnpm --filter @websync/desktop build",
    "build:packages": "pnpm --filter \"./packages/*\" type-check",
    "start": "pnpm --filter @websync/dashboard start",
    "start:dashboard": "pnpm --filter @websync/dashboard start",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  }
}
