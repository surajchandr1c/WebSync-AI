# ==============================================================================
# WebSync AI - Environment Configuration & Railway Deployment Guide
# ==============================================================================
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# In Railway: Configure variables per-service in the Railway dashboard.

# ------------------------------------------------------------------------------
# 1. COORDINATOR SERVICE (FastAPI / Uvicorn on Railway)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
COORDINATOR_HOST=0.0.0.0
# Railway automatically assigns PORT (e.g. 8080). WebSync AI reads PORT automatically.
PORT=8000
COORDINATOR_API_V1_STR=/api/v1

# Security & Cryptographic Keys (Min 32 random characters in production)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
COORDINATOR_SECRET_KEY=change-this-to-a-cryptographically-secure-key-in-production-min-32-chars
COORDINATOR_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
WORKER_TOKEN_EXPIRE_MINUTES=1440

# Pre-shared enrollment secret for worker registration. Required in production.
WORKER_ENROLLMENT_SECRET=production-worker-enrollment-secret-min-32-chars

# CORS & Frontend Origins
# In Railway: Set to your deployed dashboard domain (e.g. https://websync-dashboard.up.railway.app)
CORS_ORIGINS=https://websync-dashboard.up.railway.app,tauri://localhost
FRONTEND_URL=https://websync-dashboard.up.railway.app

# Database Persistence (Railway Managed PostgreSQL)
# Railway provides DATABASE_URL in postgresql:// or postgres:// format.
# WebSync AI automatically normalizes this to postgresql+asyncpg:// at runtime.
DATABASE_URL=postgresql://postgres:postgres_password@postgres.railway.internal:5432/railway
# Local SQLite development fallback:
# DATABASE_URL=sqlite+aiosqlite:///./coordinator.db

# Resource Limits & Quotas
MAX_QUEUED_JOBS=1000
MAX_JOB_INPUT_BYTES=2097152
MAX_WS_MESSAGE_SIZE_BYTES=2097152
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (Next.js Dashboard on Railway)
# ------------------------------------------------------------------------------
# Point to your deployed Railway coordinator public domain (HTTPS and WSS).
# Note: Next.js NEXT_PUBLIC_* variables are public to browsers. Never put secrets here.
NEXT_PUBLIC_API_URL=https://websync-coordinator.up.railway.app
NEXT_PUBLIC_WS_URL=wss://websync-coordinator.up.railway.app/ws/dashboard

# ------------------------------------------------------------------------------
# 3. WORKER AGENT SETTINGS (Physical User Computers - Outside Railway)
# ------------------------------------------------------------------------------
# Workers run on user machines (Windows, Linux, macOS) and connect over public internet:
WEB_SYNC_COORDINATOR_URL=https://websync-coordinator.up.railway.app
WEB_SYNC_WORKER_ID=node-desktop-alpha
WEB_SYNC_WORKER_NAME=Node-Alpha
WEB_SYNC_WORKER_TOKEN=production-worker-enrollment-secret-min-32-chars
WEB_SYNC_HEARTBEAT_INTERVAL=10
WEB_SYNC_LOG_LEVEL=INFO
WEB_SYNC_MAX_CONCURRENT_JOBS=2
WORKER_HEARTBEAT_TIMEOUT_SECONDS=30

# Worker Node Resource Protection & Owner Limits
WORKER_MAX_CPU_PERCENT=90.0
WORKER_MIN_AVAILABLE_RAM_MB=512
WORKER_PAUSE_SHARING=false
WORKER_MAX_INPUT_BYTES=2097152
WORKER_MAX_OUTPUT_BYTES=102400
WORKER_VERIFY_TLS=true

# Ollama / Local AI Inference (on worker PC)
WEB_SYNC_OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=300
