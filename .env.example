# WebSync AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Coordinator Service
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=8000
COORDINATOR_API_V1_STR=/api/v1
# In production, COORDINATOR_SECRET_KEY must be a cryptographically random string (min 32 chars).
COORDINATOR_SECRET_KEY=change-this-to-a-cryptographically-secure-key-in-production-min-32-chars
COORDINATOR_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
WORKER_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated allowed CORS origins. Wildcard ('*') is rejected when ENVIRONMENT=production.
COORDINATOR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost

# Coordinator Security & Resource Hardening
# Pre-shared enrollment secret for worker registration. Required in production.
WORKER_ENROLLMENT_SECRET=production-worker-enrollment-secret-min-32-chars
MAX_QUEUED_JOBS=1000
MAX_JOB_INPUT_BYTES=2097152
MAX_WS_MESSAGE_SIZE_BYTES=2097152
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=20

# Database Persistence (PostgreSQL planned; SQLite supported for local dev)
DATABASE_URL=sqlite+aiosqlite:///./coordinator.db
# PostgreSQL Production Example:
# DATABASE_URL=postgresql+asyncpg://websync_user:strong_password@coordinator-db.internal:5432/websync_ai

# Worker Agent Settings (WEB_SYNC_* primary, WORKER_* supported as aliases)
# When deploying remotely, use https:// and wss://
WEB_SYNC_COORDINATOR_URL=http://localhost:8000
WEB_SYNC_WORKER_ID=worker-node-01
WEB_SYNC_WORKER_NAME=Node-Alpha
# Matches WORKER_ENROLLMENT_SECRET in production or WORKER_DEV_AUTH_TOKEN in development
WEB_SYNC_WORKER_TOKEN=dev-worker-secret-token
WEB_SYNC_HEARTBEAT_INTERVAL=10
WEB_SYNC_LOG_LEVEL=INFO
WEB_SYNC_MAX_CONCURRENT_JOBS=2
WORKER_HEARTBEAT_TIMEOUT_SECONDS=30

# Worker Node Resource Protection & Owner Limits
WORKER_MAX_CPU_PERCENT=90.0
WORKER_MIN_AVAILABLE_RAM_MB=512
WORKER_PAUSE_SHARING=false
WORKER_MAX_INPUT_BYTES=2097152
WORKER_MAX_OUTPUT_BYTES=102400
WORKER_VERIFY_TLS=true

# Frontend Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
