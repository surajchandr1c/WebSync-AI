# WebSync AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Coordinator Service
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=8000
COORDINATOR_API_V1_STR=/api/v1
COORDINATOR_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
COORDINATOR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost

# Database Persistence (PostgreSQL planned; SQLite supported for local dev)
DATABASE_URL=sqlite+aiosqlite:///./coordinator.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/websync_ai

# Worker Agent Settings
WORKER_ID=worker-node-01
WORKER_COORDINATOR_URL=http://localhost:8000
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_AUTH_TOKEN=change-worker-token-in-production
WORKER_MAX_CONCURRENT_JOBS=2

# Frontend Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
